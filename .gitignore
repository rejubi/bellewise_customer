# ==========================================================
# Firebase
# ==========================================================

# Firebase CLI local/generated files
.firebase/
firebase-debug.log

# ----------------------------------------------------------
# IMPORTANT:
#
# Do NOT ignore these normal Flutter/Firebase client files:
#
# android/app/google-services.json
# firebase.json
# lib/firebase_options.dart
#
# They are client/project configuration and are normally
# safe to keep in the repository.
# ----------------------------------------------------------

# ==========================================================
# Firebase Admin / Service Account Credentials
# ==========================================================

firebase-key.json
firebase/*.json

*adminsdk*.json
serviceAccountKey.json

**/*serviceAccount*.json
**/*service-account*.json
**/*firebase-admin*.json

# ==========================================================
# Environment / Secrets
# ==========================================================

.env
.env.*
!.env.example

secrets.json
secrets.yaml
secrets.yml

# ==========================================================
# Google Cloud Credentials
# ==========================================================

application_default_credentials.json
gcloud-credentials.json

*.pem
*.p12
*.pfx
*.key

# ==========================================================
# IDE / OS
# ==========================================================

.DS_Store
Thumbs.db
desktop.ini